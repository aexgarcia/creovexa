generator client {
  provider            = "prisma-client"
  output              = "../src/infrastructure/persistence/prisma/generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum ProductKind {
  PRODUCT
  SERVICE
}

enum Typography {
  SANS_MODERN
  SERIF_ELEGANT
  ROUNDED
  CONDENSED_BOLD
  HANDWRITTEN
}

enum EmojiStyle {
  NONE
  FEW
  EXPRESSIVE
}

enum AddressForm {
  TU
  USTED
}

enum PhotoType {
  CUTOUT
  STUDIO
  SCENE
  PLACE
  PERSON
}

enum Currency {
  PEN
  USD
  EUR
}

model Organization {
  id                        String                   @id @db.Uuid
  name                      String
  description               String
  brandTone                 String?                  @map("brand_tone")
  industry                  String?
  country                   String                   @default("PE")
  locale                    String                   @default("es-PE")
  timeZone                  String                   @default("America/Lima") @map("time_zone")
  defaultCurrency           Currency                 @default(PEN) @map("default_currency")
  brandColors               Json?                    @map("brand_colors")
  typography                Typography?
  visualStyle               String[]                 @default([]) @map("visual_style")
  contact                   Json?
  defaultLegalText          String?                  @map("default_legal_text")
  forbiddenWords            String[]                 @default([]) @map("forbidden_words")
  audience                  String?
  valueProps                String[]                 @default([]) @map("value_props")
  emojiStyle                EmojiStyle               @default(FEW) @map("emoji_style")
  addressForm               AddressForm              @default(TU) @map("address_form")
  copyExamples              String[]                 @default([]) @map("copy_examples")
  logoAssetId               String?                  @map("logo_asset_id") @db.Uuid
  darkBackgroundLogoAssetId String?                  @map("dark_background_logo_asset_id") @db.Uuid
  iconAssetId               String?                  @map("icon_asset_id") @db.Uuid
  createdAt                 DateTime                 @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                 @map("updated_at") @db.Timestamptz(3)
  products                  Product[]
  templates                 Template[]
  campaigns                 Campaign[]
  logos                     OrganizationLogoAsset[]
  plan                      OrganizationPlan?
  memberships               OrganizationMembership[]
  aiUsage                   AiUsage[]

  @@index([createdAt])
  @@map("organizations")
}

model Product {
  archivedAt     DateTime?           @map("archived_at") @db.Timestamptz(3)
  id             String              @id @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  kind           ProductKind
  name           String
  description    String
  amountMinor    BigInt              @map("amount_minor")
  currency       Currency
  shortName      String?             @map("short_name")
  productBrand   String?             @map("product_brand")
  keyAttributes  String[]            @default([]) @map("key_attributes")
  unit           String?
  benefits       String[]            @default([])
  idealFor       String?             @map("ideal_for")
  imageAssetIds  String[]            @default([]) @map("image_asset_ids") @db.Uuid
  createdAt      DateTime            @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @map("updated_at") @db.Timestamptz(3)
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  campaigns      Campaign[]
  images         ProductImageAsset[]

  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@map("products")
}

model Template {
  archivedAt        DateTime?            @map("archived_at") @db.Timestamptz(3)
  id                String               @id @db.Uuid
  organizationId    String               @map("organization_id") @db.Uuid
  name              String
  currentRevisionId String               @map("current_revision_id") @db.Uuid
  createdAt         DateTime             @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @map("updated_at") @db.Timestamptz(3)
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revisions         TemplateRevision[]   @relation("TemplateRevisions")
  currentRevision   TemplateRevision     @relation("CurrentRevision", fields: [organizationId, id, currentRevisionId], references: [organizationId, templateId, id], onDelete: Restrict, onUpdate: NoAction)
  styleAssets       TemplateStyleAsset[]

  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@map("templates")
}

model TemplateRevision {
  id             String     @id @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  templateId     String     @map("template_id") @db.Uuid
  number         BigInt
  width          Int
  height         Int
  design         Json       @default("{\"format\":\"SQUARE\",\"composition\":\"PRODUCT_HERO\",\"style\":\"BOLD\",\"mode\":\"DARK\",\"background\":\"BRAND_COLOR\",\"logoPosition\":\"TOP_RIGHT\",\"textDensity\":\"BALANCED\",\"elements\":{\"logo\":true,\"headline\":true,\"subheadline\":false,\"productName\":true,\"keyAttributes\":0,\"regularPrice\":true,\"promotionPrice\":true,\"validity\":true,\"cta\":true,\"contact\":false,\"legalText\":false}}")
  createdAt      DateTime   @map("created_at") @db.Timestamptz(3)
  template       Template   @relation("TemplateRevisions", fields: [organizationId, templateId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  currentFor     Template[] @relation("CurrentRevision")
  campaigns      Campaign[]

  @@unique([organizationId, templateId, id])
  @@unique([organizationId, templateId, number])
  @@map("template_revisions")
}

enum CampaignStatus {
  DRAFT
  GENERATING
  PENDING_APPROVAL
  APPROVED
  PUBLISHING
  PUBLISHED
  PARTIALLY_PUBLISHED
  FAILED
}

enum MembershipRole {
  ADMIN
  EDITOR
  REVIEWER
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

enum PlanCode {
  EMPRENDE
  NEGOCIO
  AGENCIA
}

enum AiUsageKind {
  IMAGE
  COPY
  PRODUCT_SUGGESTION
}

enum AiUsageScope {
  MONTH
  DAY
}

enum CopyChannel {
  INSTAGRAM
  FACEBOOK
  WHATSAPP
}

enum CampaignObjective {
  PROMOTION
  LAUNCH
  SEASONAL
  AWARENESS
  EVENT
}

enum CampaignFailureOrigin {
  GENERATION
  PUBLICATION
}

enum GenerationFailureCode {
  GENERATION_FAILED
  TIMEOUT
  INVALID_OUTPUT
}

model Campaign {
  id                       String                 @id @db.Uuid
  organizationId           String                 @map("organization_id") @db.Uuid
  productId                String                 @map("product_id") @db.Uuid
  templateId               String                 @map("template_id") @db.Uuid
  templateRevisionId       String                 @map("template_revision_id") @db.Uuid
  objective                CampaignObjective      @default(PROMOTION)
  occasion                 String?
  channel                  CopyChannel            @default(INSTAGRAM)
  title                    String
  instructions             String
  cta                      String
  promotion                Json?
  status                   CampaignStatus
  currentGenerationId      String?                @map("current_generation_id") @db.Uuid
  candidateContentId       String?                @map("candidate_content_id") @db.Uuid
  approvedContentId        String?                @map("approved_content_id") @db.Uuid
  approvedSocialAccountIds String[]               @default([]) @map("approved_social_account_ids") @db.Uuid
  publicationProgress      Json?                  @map("publication_progress")
  failureOrigin            CampaignFailureOrigin? @map("failure_origin")
  generationFailure        GenerationFailureCode? @map("generation_failure")
  version                  BigInt
  createdAt                DateTime               @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime               @map("updated_at") @db.Timestamptz(3)
  organization             Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  product                  Product                @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  templateRevision         TemplateRevision       @relation(fields: [organizationId, templateId, templateRevisionId], references: [organizationId, templateId, id], onDelete: Restrict, onUpdate: Restrict)
  generations              CampaignGeneration[]   @relation("CampaignGenerations")
  publications             Publication[]
  currentGeneration        CampaignGeneration?    @relation("CurrentGeneration", fields: [organizationId, id, currentGenerationId], references: [organizationId, campaignId, id], onDelete: Restrict, onUpdate: NoAction, map: "campaigns_current_generation_fkey")
  candidateContent         GeneratedContent?      @relation("CandidateContent", fields: [organizationId, id, currentGenerationId, candidateContentId], references: [organizationId, campaignId, generationId, id], onDelete: Restrict, onUpdate: NoAction, map: "campaigns_candidate_content_fkey")

  @@unique([organizationId, id])
  @@index([organizationId, status, createdAt])
  @@index([status, createdAt])
  @@index([organizationId, createdAt])
  @@map("campaigns")
}

model CampaignGeneration {
  id             String                     @id @db.Uuid
  organizationId String                     @map("organization_id") @db.Uuid
  campaignId     String                     @map("campaign_id") @db.Uuid
  number         BigInt
  snapshot       Json
  requestedAt    DateTime                   @map("requested_at") @db.Timestamptz(3)
  campaign       Campaign                   @relation("CampaignGenerations", fields: [organizationId, campaignId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  currentFor     Campaign[]                 @relation("CurrentGeneration")
  content        GeneratedContent?
  copy           CampaignCopy?
  imageJob       CampaignImageJob?
  assets         CampaignAsset[]
  failure        CampaignGenerationFailure?

  @@unique([organizationId, campaignId, id])
  @@unique([organizationId, campaignId, number])
  @@index([organizationId, campaignId, requestedAt])
  @@map("campaign_generations")
}

model GeneratedContent {
  id             String             @id @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  campaignId     String             @map("campaign_id") @db.Uuid
  generationId   String             @unique @map("generation_id") @db.Uuid
  headline       String
  subheadline    String?
  caption        String
  cta            String
  hashtags       String[]
  assetIds       String[]           @map("asset_ids") @db.Uuid
  createdAt      DateTime           @map("created_at") @db.Timestamptz(3)
  generation     CampaignGeneration @relation(fields: [organizationId, campaignId, generationId], references: [organizationId, campaignId, id], onDelete: Restrict, onUpdate: Restrict)
  candidateFor   Campaign[]         @relation("CandidateContent")
  publications   Publication[]

  @@unique([organizationId, campaignId, generationId, id], map: "generated_contents_owner_generation_id_key")
  @@unique([organizationId, campaignId, generationId], map: "generated_contents_owner_generation_key")
  @@unique([organizationId, campaignId, id], map: "generated_contents_owner_id_key")
  @@index([organizationId, campaignId, createdAt])
  @@map("generated_contents")
}

model CampaignGenerationFailure {
  generationId String                @id @map("generation_id") @db.Uuid
  code         GenerationFailureCode
  recordedAt   DateTime              @map("recorded_at") @db.Timestamptz(3)
  generation   CampaignGeneration    @relation(fields: [generationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("campaign_generation_failures")
}

enum PublicationStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  TIKTOK
}

enum PublicationFailureCode {
  REJECTED
  ACCOUNT_UNAVAILABLE
  RATE_LIMITED
}

model Publication {
  id                String                  @id @db.Uuid
  organizationId    String                  @map("organization_id") @db.Uuid
  campaignId        String                  @map("campaign_id") @db.Uuid
  approvedContentId String                  @map("approved_content_id") @db.Uuid
  socialAccountId   String                  @map("social_account_id") @db.Uuid
  platform          SocialPlatform
  status            PublicationStatus
  currentAttemptId  String?                 @map("current_attempt_id") @db.Uuid
  externalPostId    String?                 @map("external_post_id")
  failureCode       PublicationFailureCode? @map("failure_code")
  publishedAt       DateTime?               @map("published_at") @db.Timestamptz(3)
  version           BigInt
  createdAt         DateTime                @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                @map("updated_at") @db.Timestamptz(3)
  campaign          Campaign                @relation(fields: [organizationId, campaignId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  approvedContent   GeneratedContent        @relation(fields: [organizationId, campaignId, approvedContentId], references: [organizationId, campaignId, id], onDelete: Restrict, onUpdate: Restrict)
  attempts          PublicationAttempt[]    @relation("PublicationAttempts")
  currentAttempt    PublicationAttempt?     @relation("CurrentAttempt", fields: [organizationId, id, currentAttemptId], references: [organizationId, publicationId, id], onDelete: Restrict, onUpdate: NoAction, map: "publications_current_attempt_fkey")

  @@unique([organizationId, id])
  @@unique([organizationId, campaignId, approvedContentId, socialAccountId], map: "publications_destination_key")
  @@index([organizationId, campaignId, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([status, createdAt])
  @@map("publications")
}

model PublicationAttempt {
  id             String                    @id @db.Uuid
  organizationId String                    @map("organization_id") @db.Uuid
  publicationId  String                    @map("publication_id") @db.Uuid
  number         BigInt
  startedAt      DateTime                  @map("started_at") @db.Timestamptz(3)
  publication    Publication               @relation("PublicationAttempts", fields: [organizationId, publicationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  currentFor     Publication[]             @relation("CurrentAttempt")
  result         PublicationAttemptResult?

  @@unique([organizationId, publicationId, id])
  @@unique([organizationId, publicationId, number], map: "publication_attempts_number_key")
  @@index([organizationId, publicationId, startedAt])
  @@map("publication_attempts")
}

model PublicationAttemptResult {
  attemptId      String                  @id @map("attempt_id") @db.Uuid
  status         PublicationStatus
  externalPostId String?                 @map("external_post_id")
  failureCode    PublicationFailureCode? @map("failure_code")
  recordedAt     DateTime                @map("recorded_at") @db.Timestamptz(3)
  attempt        PublicationAttempt      @relation(fields: [attemptId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("publication_attempt_results")
}

enum CampaignCopyStatus {
  QUEUED
  RUNNING
  READY
  FAILED
}

model CampaignCopy {
  generationId   String             @id @map("generation_id") @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  campaignId     String             @map("campaign_id") @db.Uuid
  token          String             @db.Uuid
  status         CampaignCopyStatus
  expiresAt      DateTime           @map("expires_at") @db.Timestamptz(3)
  content        Json?
  failureCode    String?            @map("failure_code")
  generation     CampaignGeneration @relation(fields: [organizationId, campaignId, generationId], references: [organizationId, campaignId, id], onDelete: Restrict, onUpdate: Restrict, map: "campaign_copies_generation_fkey")

  @@unique([organizationId, campaignId, generationId], map: "campaign_copies_owner_generation_key")
  @@index([organizationId, campaignId], map: "campaign_copies_owner_idx")
  @@map("campaign_copies")
}

enum CampaignImageJobStatus {
  QUEUED
  RUNNING
  READY
  FAILED
}

enum CampaignAssetPurpose {
  BASE_IMAGE
  FINAL_PIECE
}

model CampaignImageJob {
  generationId    String                 @id @map("generation_id") @db.Uuid
  organizationId  String                 @map("organization_id") @db.Uuid
  campaignId      String                 @map("campaign_id") @db.Uuid
  token           String                 @db.Uuid
  expectedVersion BigInt                 @map("expected_version")
  status          CampaignImageJobStatus
  expiresAt       DateTime               @map("expires_at") @db.Timestamptz(3)
  failureCode     String?                @map("failure_code")
  generation      CampaignGeneration     @relation(fields: [organizationId, campaignId, generationId], references: [organizationId, campaignId, id], onDelete: Restrict, onUpdate: Restrict, map: "campaign_image_jobs_generation_fkey")

  @@unique([organizationId, campaignId, generationId], map: "campaign_image_jobs_owner_generation_key")
  @@index([status, expiresAt])
  @@map("campaign_image_jobs")
}

model CampaignAsset {
  id             String               @id @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  campaignId     String               @map("campaign_id") @db.Uuid
  generationId   String               @map("generation_id") @db.Uuid
  operationId    String               @map("operation_id") @db.Uuid
  purpose        CampaignAssetPurpose
  bucket         String
  objectKey      String               @map("object_key")
  sha256         String
  byteLength     Int                  @map("byte_length")
  contentType    String               @map("content_type")
  width          Int
  height         Int
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  generation     CampaignGeneration   @relation(fields: [organizationId, campaignId, generationId], references: [organizationId, campaignId, id], onDelete: Restrict, onUpdate: Restrict, map: "campaign_assets_generation_fkey")

  @@unique([organizationId, campaignId, generationId, operationId, purpose], map: "campaign_assets_operation_key")
  @@unique([bucket, objectKey])
  @@index([organizationId, id])
  @@map("campaign_assets")
}

model ProductImageAsset {
  id              String     @id @db.Uuid
  organizationId  String     @map("organization_id") @db.Uuid
  productId       String     @map("product_id") @db.Uuid
  bucket          String
  objectKey       String     @unique @map("object_key")
  sha256          String
  byteLength      Int        @map("byte_length")
  contentType     String     @map("content_type")
  width           Int
  height          Int
  photoType       PhotoType? @map("photo_type")
  hasTransparency Boolean?   @map("has_transparency")
  createdAt       DateTime   @map("created_at") @db.Timestamptz(3)
  product         Product    @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, productId, id])
  @@map("product_image_assets")
}

model OrganizationLogoAsset {
  id              String       @id @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  bucket          String
  objectKey       String       @unique @map("object_key")
  sha256          String
  byteLength      Int          @map("byte_length")
  contentType     String       @map("content_type")
  width           Int
  height          Int
  isDark          Boolean?     @map("is_dark")
  suggestedColors Json?        @map("suggested_colors")
  createdAt       DateTime     @map("created_at") @db.Timestamptz(3)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, id])
  @@map("organization_logo_assets")
}

model TemplateStyleAsset {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  templateId     String   @map("template_id") @db.Uuid
  bucket         String
  objectKey      String   @unique @map("object_key")
  sha256         String
  byteLength     Int      @map("byte_length")
  contentType    String   @map("content_type")
  width          Int
  height         Int
  createdAt      DateTime @map("created_at") @db.Timestamptz(3)
  template       Template @relation(fields: [organizationId, templateId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "template_style_assets_template_fkey")

  @@index([organizationId, templateId, id])
  @@map("template_style_assets")
}

// Plan de la organización (ADR-0033). Lo asigna el propietario del despliegue.
model OrganizationPlan {
  organizationId String       @id @map("organization_id") @db.Uuid
  plan           PlanCode
  // Fecha local en que empezó el plan: fija el día de reinicio mensual.
  periodAnchor   DateTime     @map("period_anchor") @db.Date
  assignedAt     DateTime     @map("assigned_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("organization_plans")
}

// Unidades de IA usadas por período (ADR-0033).
model AiUsage {
  organizationId String       @map("organization_id") @db.Uuid
  kind           AiUsageKind
  scope          AiUsageScope
  periodStart    DateTime     @map("period_start") @db.Date
  used           Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([organizationId, kind, scope, periodStart])
  @@map("ai_usage")
}

// Identidad (ADR-0012). Las cuatro tablas siguen el esquema de Better Auth; sus campos los
// escribe Better Auth mediante su adapter de Prisma.
model User {
  id            String                   @id @db.Uuid
  name          String
  email         String                   @unique
  emailVerified Boolean                  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime                 @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                 @map("updated_at") @db.Timestamptz(3)
  sessions      Session[]
  accounts      Account[]
  memberships   OrganizationMembership[]

  @@map("users")
}

model Session {
  id        String   @id @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  // Hash de la contraseña; lo calcula Better Auth, nunca el código de Creovexa.
  password              String?
  createdAt             DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @map("updated_at") @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

// Pertenencia de un usuario a una organización (ADR-0012). Autenticarse no la crea.
model OrganizationMembership {
  id             String           @id @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           MembershipRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @map("updated_at") @db.Timestamptz(3)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_memberships")
}
