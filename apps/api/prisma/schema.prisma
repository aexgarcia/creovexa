generator client {
  provider            = "prisma-client"
  output              = "../src/infrastructure/persistence/prisma/generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum ProductKind {
  PRODUCT
  SERVICE
}

enum Currency {
  PEN
  USD
  EUR
}

model Organization {
  id          String     @id @db.Uuid
  name        String
  description String
  brandTone   String?    @map("brand_tone")
  logoAssetId String?    @map("logo_asset_id") @db.Uuid
  createdAt   DateTime   @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @map("updated_at") @db.Timestamptz(3)
  products    Product[]
  templates   Template[]
  campaigns   Campaign[]

  @@index([createdAt])
  @@map("organizations")
}

model Product {
  id             String       @id @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  kind           ProductKind
  name           String
  description    String
  amountMinor    BigInt       @map("amount_minor")
  currency       Currency
  imageAssetIds  String[]     @default([]) @map("image_asset_ids") @db.Uuid
  createdAt      DateTime     @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  campaigns      Campaign[]

  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@map("products")
}

model Template {
  id                String             @id @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  name              String
  currentRevisionId String             @map("current_revision_id") @db.Uuid
  createdAt         DateTime           @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @map("updated_at") @db.Timestamptz(3)
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revisions         TemplateRevision[] @relation("TemplateRevisions")
  currentRevision   TemplateRevision   @relation("CurrentRevision", fields: [organizationId, id, currentRevisionId], references: [organizationId, templateId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@map("templates")
}

model TemplateRevision {
  id             String     @id @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  templateId     String     @map("template_id") @db.Uuid
  number         BigInt
  width          Int
  height         Int
  createdAt      DateTime   @map("created_at") @db.Timestamptz(3)
  template       Template   @relation("TemplateRevisions", fields: [organizationId, templateId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  currentFor     Template[] @relation("CurrentRevision")
  campaigns      Campaign[]

  @@unique([organizationId, templateId, id])
  @@unique([organizationId, templateId, number])
  @@map("template_revisions")
}

enum CampaignStatus {
  DRAFT
  GENERATING
  PENDING_APPROVAL
  APPROVED
  PUBLISHING
  PUBLISHED
  PARTIALLY_PUBLISHED
  FAILED
}

enum CampaignFailureOrigin {
  GENERATION
  PUBLICATION
}

enum GenerationFailureCode {
  GENERATION_FAILED
  TIMEOUT
  INVALID_OUTPUT
}

model Campaign {
  id                       String                 @id @db.Uuid
  organizationId           String                 @map("organization_id") @db.Uuid
  productId                String                 @map("product_id") @db.Uuid
  templateId               String                 @map("template_id") @db.Uuid
  templateRevisionId       String                 @map("template_revision_id") @db.Uuid
  title                    String
  instructions             String
  cta                      String
  promotion                Json?
  status                   CampaignStatus
  currentGenerationId      String?                @map("current_generation_id") @db.Uuid
  candidateContentId       String?                @map("candidate_content_id") @db.Uuid
  approvedContentId        String?                @map("approved_content_id") @db.Uuid
  approvedSocialAccountIds String[]               @default([]) @map("approved_social_account_ids") @db.Uuid
  publicationProgress      Json?                  @map("publication_progress")
  failureOrigin            CampaignFailureOrigin? @map("failure_origin")
  generationFailure        GenerationFailureCode? @map("generation_failure")
  version                  BigInt
  createdAt                DateTime               @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime               @map("updated_at") @db.Timestamptz(3)
  organization             Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  product                  Product                @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  templateRevision         TemplateRevision       @relation(fields: [organizationId, templateId, templateRevisionId], references: [organizationId, templateId, id], onDelete: Restrict, onUpdate: Restrict)
  generations              CampaignGeneration[]   @relation("CampaignGenerations")
  publications             Publication[]
  currentGeneration        CampaignGeneration?    @relation("CurrentGeneration", fields: [organizationId, id, currentGenerationId], references: [organizationId, campaignId, id], onDelete: Restrict, onUpdate: NoAction, map: "campaigns_current_generation_fkey")
  candidateContent         GeneratedContent?      @relation("CandidateContent", fields: [organizationId, id, currentGenerationId, candidateContentId], references: [organizationId, campaignId, generationId, id], onDelete: Restrict, onUpdate: NoAction, map: "campaigns_candidate_content_fkey")

  @@unique([organizationId, id])
  @@index([organizationId, status, createdAt])
  @@index([status, createdAt])
  @@index([organizationId, createdAt])
  @@map("campaigns")
}

model CampaignGeneration {
  id             String                     @id @db.Uuid
  organizationId String                     @map("organization_id") @db.Uuid
  campaignId     String                     @map("campaign_id") @db.Uuid
  number         BigInt
  snapshot       Json
  requestedAt    DateTime                   @map("requested_at") @db.Timestamptz(3)
  campaign       Campaign                   @relation("CampaignGenerations", fields: [organizationId, campaignId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  currentFor     Campaign[]                 @relation("CurrentGeneration")
  content        GeneratedContent?
  failure        CampaignGenerationFailure?

  @@unique([organizationId, campaignId, id])
  @@unique([organizationId, campaignId, number])
  @@index([organizationId, campaignId, requestedAt])
  @@map("campaign_generations")
}

model GeneratedContent {
  id             String             @id @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  campaignId     String             @map("campaign_id") @db.Uuid
  generationId   String             @unique @map("generation_id") @db.Uuid
  headline       String
  caption        String
  cta            String
  hashtags       String[]
  assetIds       String[]           @map("asset_ids") @db.Uuid
  createdAt      DateTime           @map("created_at") @db.Timestamptz(3)
  generation     CampaignGeneration @relation(fields: [organizationId, campaignId, generationId], references: [organizationId, campaignId, id], onDelete: Restrict, onUpdate: Restrict)
  candidateFor   Campaign[]         @relation("CandidateContent")
  publications   Publication[]

  @@unique([organizationId, campaignId, generationId, id], map: "generated_contents_owner_generation_id_key")
  @@unique([organizationId, campaignId, generationId], map: "generated_contents_owner_generation_key")
  @@unique([organizationId, campaignId, id], map: "generated_contents_owner_id_key")
  @@index([organizationId, campaignId, createdAt])
  @@map("generated_contents")
}

model CampaignGenerationFailure {
  generationId String                @id @map("generation_id") @db.Uuid
  code         GenerationFailureCode
  recordedAt   DateTime              @map("recorded_at") @db.Timestamptz(3)
  generation   CampaignGeneration    @relation(fields: [generationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("campaign_generation_failures")
}

enum PublicationStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  TIKTOK
}

enum PublicationFailureCode {
  REJECTED
  ACCOUNT_UNAVAILABLE
  RATE_LIMITED
}

model Publication {
  id                String                  @id @db.Uuid
  organizationId    String                  @map("organization_id") @db.Uuid
  campaignId        String                  @map("campaign_id") @db.Uuid
  approvedContentId String                  @map("approved_content_id") @db.Uuid
  socialAccountId   String                  @map("social_account_id") @db.Uuid
  platform          SocialPlatform
  status            PublicationStatus
  currentAttemptId  String?                 @map("current_attempt_id") @db.Uuid
  externalPostId    String?                 @map("external_post_id")
  failureCode       PublicationFailureCode? @map("failure_code")
  publishedAt       DateTime?               @map("published_at") @db.Timestamptz(3)
  version           BigInt
  createdAt         DateTime                @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                @map("updated_at") @db.Timestamptz(3)
  campaign          Campaign                @relation(fields: [organizationId, campaignId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  approvedContent   GeneratedContent        @relation(fields: [organizationId, campaignId, approvedContentId], references: [organizationId, campaignId, id], onDelete: Restrict, onUpdate: Restrict)
  attempts          PublicationAttempt[]    @relation("PublicationAttempts")
  currentAttempt    PublicationAttempt?     @relation("CurrentAttempt", fields: [organizationId, id, currentAttemptId], references: [organizationId, publicationId, id], onDelete: Restrict, onUpdate: NoAction, map: "publications_current_attempt_fkey")

  @@unique([organizationId, id])
  @@unique([organizationId, campaignId, approvedContentId, socialAccountId], map: "publications_destination_key")
  @@index([organizationId, campaignId, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([status, createdAt])
  @@map("publications")
}

model PublicationAttempt {
  id             String                    @id @db.Uuid
  organizationId String                    @map("organization_id") @db.Uuid
  publicationId  String                    @map("publication_id") @db.Uuid
  number         BigInt
  startedAt      DateTime                  @map("started_at") @db.Timestamptz(3)
  publication    Publication               @relation("PublicationAttempts", fields: [organizationId, publicationId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  currentFor     Publication[]             @relation("CurrentAttempt")
  result         PublicationAttemptResult?

  @@unique([organizationId, publicationId, id])
  @@unique([organizationId, publicationId, number], map: "publication_attempts_number_key")
  @@index([organizationId, publicationId, startedAt])
  @@map("publication_attempts")
}

model PublicationAttemptResult {
  attemptId      String                  @id @map("attempt_id") @db.Uuid
  status         PublicationStatus
  externalPostId String?                 @map("external_post_id")
  failureCode    PublicationFailureCode? @map("failure_code")
  recordedAt     DateTime                @map("recorded_at") @db.Timestamptz(3)
  attempt        PublicationAttempt      @relation(fields: [attemptId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("publication_attempt_results")
}
