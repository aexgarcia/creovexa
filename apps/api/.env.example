API_PORT=3001
API_HOST=127.0.0.1
CORS_ORIGIN=http://localhost:3000
# pnpm setup:env completa esta URL a partir del PostgreSQL local.
DATABASE_URL=__LOCAL_DATABASE_URL__
# Organización fija para probar el catálogo; se habilita con pnpm db:seed:dev.
# No se permite en NODE_ENV=production.
DEV_ORGANIZATION_ID=
# Generacion de texto opcional. Sin clave, el endpoint responde 503.
# Proveedor activo: gemini (predeterminado) u openai. No hay fallback automatico.
COPY_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_COPY_MODEL=gemini-3.5-flash-lite
GEMINI_COPY_TIMEOUT_MS=20000
# Solo se utilizan si COPY_PROVIDER=openai.
OPENAI_API_KEY=
# Modelo habilitado en tu cuenta con Structured Outputs.
OPENAI_COPY_MODEL=gpt-6-luna
# Esfuerzo de razonamiento: none, minimal, low, medium, high, xhigh o max. Cada modelo acepta solo
# algunos (gpt-6-luna no acepta minimal; gpt-5-mini sí). Vacío: no se envía y el modelo usa el suyo.
OPENAI_COPY_REASONING_EFFORT=low
# Tiempo por intento; maximo dos intentos. Rango: 100-40000 ms.
OPENAI_COPY_TIMEOUT_MS=20000
# Botón «Sugerir con IA» del producto (ADR-0031): usa el proveedor, modelo y clave del copy y
# cuesta una llamada por clic. false lo apaga sin tocar la clave. Vacío: true.
PRODUCT_SUGGESTIONS_ENABLED=true

# IA visual independiente del copy. Deshabilitada por defecto para pruebas sin cobros.
# Los modelos de imagen Gemini por API no tienen nivel gratuito.
# Para habilitar explícitamente: IMAGE_PROVIDER=gemini y un modelo de imagen de tu cuenta.
IMAGE_PROVIDER=disabled
# Para OpenAI: IMAGE_PROVIDER=openai. Comparte OPENAI_API_KEY con el copy.
OPENAI_IMAGE_MODEL=gpt-image-2
# Calidad si el pedido no indica una (scripts y pruebas). El CMS pide LOW o MEDIUM según el
# plan de la organización (ADR-0033).
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_TIMEOUT_MS=120000
# Modo del flyer (ADR-0009). AI_FULL: la IA dibuja el flyer completo, el sistema pega el logo
# y lo verifica con visión. COMPOSED: imagen base y textos con Playwright (solo 1080 × 1080).
# Vacío: AI_FULL con OpenAI y COMPOSED con Gemini. Gemini no admite AI_FULL.
IMAGE_MODE=
# Lectura de visión que verifica el flyer en AI_FULL; usa OPENAI_API_KEY. Rango: 100-90000 ms.
OPENAI_VISION_MODEL=gpt-5-mini
OPENAI_VISION_TIMEOUT_MS=60000
# Ejemplo vigente: gemini-3.1-flash-image. No reutilizar GEMINI_COPY_MODEL.
GEMINI_IMAGE_MODEL=
# Un intento por solicitud; sin retry automático. Rango: 100-120000 ms.
GEMINI_IMAGE_TIMEOUT_MS=60000
# Renderer local Playwright. Preparar Chromium con pnpm --filter @creovexa/api renderer:setup.
# Rango: 100-30000 ms para lanzamiento y composicion. No hace llamadas de IA.
RENDER_TIMEOUT_MS=20000

# Fase 6: almacenamiento privado de fotos del catálogo y assets de campaña.
# Crear un bucket privado antes de habilitar el adaptador. No usar credenciales públicas.
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=creovexa-assets
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Cola de trabajos en PostgreSQL (pg-boss). Generar copy e imagen se ejecuta en segundo plano.
# JOB_WORKER: si este proceso ejecuta los trabajos. Por defecto true, así basta un contenedor.
# Con un worker aparte (pnpm --filter @creovexa/api start:worker), pon JOB_WORKER=false en la API.
JOB_WORKER=true
# JOB_SCHEMA: schema de las tablas de la cola. Vacío usa "pgboss" (o "<schema>_jobs" si
# DATABASE_URL indica otro schema). Hasta 50 caracteres: minúsculas, dígitos y _.
JOB_SCHEMA=
