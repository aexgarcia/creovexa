API_PORT=3001
API_HOST=127.0.0.1
CORS_ORIGIN=http://localhost:3000
# pnpm setup:env completa esta URL a partir del PostgreSQL local.
DATABASE_URL=__LOCAL_DATABASE_URL__
# Organización fija para probar el catálogo; se habilita con pnpm db:seed:dev.
# No se permite en NODE_ENV=production.
DEV_ORGANIZATION_ID=
# Generacion de texto opcional. Sin clave, el endpoint responde 503.
OPENAI_API_KEY=
# Modelo habilitado en tu cuenta con Structured Outputs.
OPENAI_COPY_MODEL=
# Tiempo por intento; maximo dos intentos. Rango: 100-40000 ms.
OPENAI_COPY_TIMEOUT_MS=20000
