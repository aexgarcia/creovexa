# pnpm setup:env genera secretos locales y conserva los archivos existentes.
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_PORT=5432
POSTGRES_USER=creovexa_admin
POSTGRES_PASSWORD=__GENERATE_POSTGRES_PASSWORD__
POSTGRES_DB=creovexa
N8N_DB_USER=creovexa_n8n
N8N_DB_PASSWORD=__GENERATE_N8N_DB_PASSWORD__
N8N_DB_NAME=creovexa_n8n
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.39.6
N8N_PORT=5678
N8N_ENCRYPTION_KEY=__GENERATE_N8N_ENCRYPTION_KEY__
MINIO_IMAGE=creovexa-minio:RELEASE.2025-10-15T17-29-55Z
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=creovexa_storage
MINIO_ROOT_PASSWORD=__GENERATE_MINIO_ROOT_PASSWORD__
TZ=America/Lima
